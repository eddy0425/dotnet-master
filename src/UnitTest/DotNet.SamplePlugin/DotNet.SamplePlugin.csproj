<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <!--
    外置插件样例：只引用 DotNet.Drawing + DotNet.HalconCore（+ halcondotnet），编译出的 dll 丢进宿主的 plugins\ 即可。
    共享程序集一律 Private=false：插件目录里不得带它们的副本（AlgoCatalog 会拒绝加载）。
    测试把本项目的输出复制到临时 plugins 目录里，验证"外置插件可用"。
  -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{6E4B0C1A-3F7D-4A52-9C8E-2B1D5F0A7E31}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>DotNet.SamplePlugin</RootNamespace>
    <AssemblyName>DotNet.SamplePlugin</AssemblyName>
    <TargetFrameworkVersion>v4.5.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="halcondotnet">
      <HintPath>$(DotNetDllDir)\Halcon\halcondotnet.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 只为参数迁移 (MigratePara 的 JObject); 与 halcondotnet 一样用宿主的那一份, 不复制到插件目录 -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DotNetDllDir)\Newtonsoft.Json\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="RegionAreaStrategy.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Using\DotNet.Drawing\DotNet.Drawing.csproj">
      <Project>{ce09acc5-0e8d-4d7d-aa2b-d47b837f2cd2}</Project>
      <Name>DotNet.Drawing</Name>
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\Using\DotNet.HalconCore\DotNet.HalconCore.csproj">
      <Project>{7b2e4c10-9d6a-4f31-a5c8-3e0b1d742f96}</Project>
      <Name>DotNet.HalconCore</Name>
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
